    <string name="signup_button">Sign up</string>
    <!-- Trailing space is intentional — a bold "Sign in" link is appended right after it -->
    <string name="signup_have_account_prompt">Already have an account? </string>
    <string name="signup_sign_in_link">Sign in</string>

    <!-- ===================== Password reset (local-only OTP screen, see ProfileRepository) ===================== -->

    <string name="reset_headline">Check your mail</string>
    <!-- %1$s is the profile's email address -->
    <string name="reset_body">We sent a six digit code to %1$s. Enter it below to reset your password.</string>
    <!-- Fallback shown in reset_body when no profile email is on file yet -->
    <string name="reset_default_email">your email</string>
    <string name="reset_resend_prompt">Didn\'t receive the email?</string>
    <!-- First half of the resend-countdown line; the bold "%1$d s" suffix (reset_resend_seconds)
         is appended in a different text color, so the two are separate resources -->
    <string name="reset_resend_prefix">You can resend the code in </string>
    <string name="reset_resend_seconds">%1$d s</string>
    <string name="reset_confirm_button">Confirm</string>

