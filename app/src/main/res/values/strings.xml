    <string name="signin_headline">Welcome back</string>
    <string name="signin_body">Docket keeps everything on this device. Sign in only if you want backup and sync.</string>
    <string name="signin_email_label">Email</string>
    <string name="signin_password_label">Password</string>
    <string name="signin_remember_me">Remember me</string>
    <string name="signin_forgot_password">Forgot password</string>
    <!-- Divider text between the email/password fields and the social sign-in row -->
    <string name="signin_or_continue_with">or continue with</string>
    <string name="signin_button">Sign in</string>
    <!-- Trailing space is intentional — a bold "Sign up" link is appended right after it -->
    <string name="signin_no_account_prompt">Don\'t have an account? </string>
    <string name="signin_sign_up_link">Sign up</string>

    <!-- ===================== Sign up ===================== -->

    <string name="signup_headline">Create account</string>
    <string name="signup_body">Free forever. Premium is a single purchase, never a subscription.</string>
    <string name="signup_name_label">Full name</string>
    <string name="signup_email_label">Email</string>
    <string name="signup_password_label">Password</string>
