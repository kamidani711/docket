<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Saved documents (originals, PDFs, image-set pages, thumbnails). -->
    <files-path name="documents" path="documents/" />
    <!-- Fresh copies produced by the export flow (page size/quality vary per export, so these
         are never just the permanent stored file). -->
    <files-path name="exports" path="exports/" />
</paths>
